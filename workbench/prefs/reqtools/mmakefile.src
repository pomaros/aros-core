#
#   Makefile to make Prefs/ReqTools.

include $(SRCDIR)/config/aros.cfg

FILES := main args reqtoolseditor reqtoolsstringify locale misc prefs

EXEDIR := $(AROSDIR)/Prefs

#MM- workbench-prefs : workbench-prefs-reqtools
#MM workbench-prefs-reqtools : includes linklibs workbench-prefs-reqtools-catalogs

%build_prog mmake=workbench-prefs-reqtools \
    progname=ReqTools targetdir=$(EXEDIR) \
    files=$(FILES)

# The same editor as a shared class for the settings window.
CLASSFILES := args reqtoolsstringify locale misc prefs reqtoolseditor_init reqtoolseditor_mcc

#MM- workbench-prefs : workbench-prefs-reqtools-class
#MM workbench-prefs-reqtools-class : includes linklibs workbench-prefs-reqtools-catalogs workbench-classes-zune-prefseditor

%build_module mmake=workbench-prefs-reqtools-class \
    modname=ReqToolsEditor modtype=mcc \
    conffile=reqtoolseditor.conf files="$(CLASSFILES)"

%common
