#
#   Makefile to make Prefs/Asl.

include $(SRCDIR)/config/aros.cfg

FILES := main args asleditor aslstringify locale misc prefs

EXEDIR := $(AROSDIR)/Prefs

#MM- workbench-prefs : workbench-prefs-asl
#MM workbench-prefs-asl : includes linklibs workbench-prefs-asl-catalogs

%build_prog mmake=workbench-prefs-asl \
    progname=Asl targetdir=$(EXEDIR) \
    files=$(FILES)

# The same editor as a shared class for the settings window.
CLASSFILES := args aslstringify locale misc prefs asleditor_init asleditor_mcc

#MM- workbench-prefs : workbench-prefs-asl-class
#MM workbench-prefs-asl-class : includes linklibs workbench-prefs-asl-catalogs workbench-classes-zune-prefseditor

%build_module mmake=workbench-prefs-asl-class \
    modname=AslEditor modtype=mcc \
    conffile=asleditor.conf files="$(CLASSFILES)"

%common
