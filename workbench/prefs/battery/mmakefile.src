include $(SRCDIR)/config/aros.cfg

#MM- workbench-prefs : workbench-prefs-battery
#MM workbench-prefs-battery : workbench-prefs-battery-class workbench-classes-zune-systemprefswindow includes linklibs
#MM workbench-prefs-battery-class : workbench-classes-zune-prefseditor includes linklibs workbench-libs-power-includes

%build_prog mmake=workbench-prefs-battery \
    progname=Battery targetdir=$(AROS_PREFS) files=main

%build_module mmake=workbench-prefs-battery-class \
    modname=BatteryEditor modtype=mcc conffile=editor.conf \
    files="editor $(SRCDIR)/workbench/system/Indicators/consumers $(SRCDIR)/workbench/system/Indicators/cpu_tasks"

%common
