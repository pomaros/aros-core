include $(SRCDIR)/config/aros.cfg
#MM- workbench-prefs : workbench-prefs-softwareupdate
#MM workbench-prefs-softwareupdate : workbench-prefs-softwareupdate-class workbench-classes-zune-systemprefswindow
#MM workbench-prefs-softwareupdate-class : includes linklibs workbench-classes-zune-prefseditor
%build_prog mmake=workbench-prefs-softwareupdate progname=SoftwareUpdate targetdir=$(AROS_PREFS) files="main"
%build_module mmake=workbench-prefs-softwareupdate-class modname=SoftwareUpdateEditor modtype=mcc conffile=editor.conf files="editor status index"
%common
