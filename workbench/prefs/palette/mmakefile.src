# Makefile to make Palette prefs program.

include $(SRCDIR)/config/aros.cfg

FILES   := main locale paleditor palette prefs args misc
EXEDIR  := $(AROSDIR)/Prefs

#MM- workbench-prefs : workbench-prefs-palette
#MM workbench-prefs-palette : includes linklibs workbench-prefs-palette-catalogs \
#MM workbench-prefs-palette-icons

#USER_CPPFLAGS := -DDEBUG=1

%build_prog mmake=workbench-prefs-palette \
    progname=Palette targetdir=$(EXEDIR) \
    files=$(FILES)

# The same editor as a shared class for the settings window.
CLASSFILES := locale palette prefs args misc paletteeditor_init paleditor_mcc

#MM- workbench-prefs : workbench-prefs-palette-class
#MM workbench-prefs-palette-class : includes linklibs workbench-prefs-palette-catalogs workbench-prefs-palette-icons workbench-classes-zune-prefseditor

%build_module mmake=workbench-prefs-palette-class \
    modname=PaletteEditor modtype=mcc \
    conffile=paletteeditor.conf files="$(CLASSFILES)"

%common
