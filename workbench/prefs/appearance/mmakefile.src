include $(SRCDIR)/config/aros.cfg

FILES  := main appearanceeditor themepreview misc locale args

EXEDIR := $(AROS_PREFS)

USER_CFLAGS := $(PARANOIA_CFLAGS)

#MM- workbench-prefs : workbench-prefs-appearance
#MM workbench-prefs-appearance : includes linklibs workbench-prefs-appearance-catalogs \
#MM     workbench-libs-decorator-includes workbench-libs-decortheme-includes

%build_prog mmake=workbench-prefs-appearance \
    progname=Appearance targetdir=$(EXEDIR) \
    files=$(FILES) uselibs="mui"

# The same editor as a shared class for the settings window.
CLASSFILES := themepreview misc locale args appearanceeditor_init appearanceeditor_mcc

#MM- workbench-prefs : workbench-prefs-appearance-class
#MM workbench-prefs-appearance-class : includes linklibs workbench-prefs-appearance-catalogs \ workbench-classes-zune-prefseditor

%build_module mmake=workbench-prefs-appearance-class \
    modname=AppearanceEditor modtype=mcc \
    conffile=appearanceeditor.conf files="$(CLASSFILES)"

%common
