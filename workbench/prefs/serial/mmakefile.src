# Makefile to make Serial prefs program.

include $(SRCDIR)/config/aros.cfg

FILES := main locale sereditor prefs args misc

#vars misc prefs

EXEDIR      := $(AROSDIR)/Prefs

#MM- workbench-prefs : workbench-prefs-serial
#MM workbench-prefs-serial : includes linklibs workbench-prefs-serial-catalogs

%build_prog mmake=workbench-prefs-serial \
    progname=Serial targetdir=$(EXEDIR) \
    files=$(FILES)

# The same editor as a shared class for the settings window.
CLASSFILES := locale prefs args misc serialeditor_init sereditor_mcc

#MM- workbench-prefs : workbench-prefs-serial-class
#MM workbench-prefs-serial-class : includes linklibs workbench-prefs-serial-catalogs workbench-classes-zune-prefseditor

%build_module mmake=workbench-prefs-serial-class \
    modname=SerialEditor modtype=mcc \
    conffile=serialeditor.conf files="$(CLASSFILES)"

%common
