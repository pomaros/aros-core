#
# One schema per IFF prefs file, installed beside the editors so
# settings.library and the settings window find them in SYS:Prefs/Schemas.

include $(SRCDIR)/config/aros.cfg

SCHEMAS := $(call WILDCARD, *.schema)

#MM- workbench-prefs : workbench-prefs-schemas

%copy_files_q mmake=workbench-prefs-schemas files=$(SCHEMAS) dst=$(AROS_PREFS)/Schemas
