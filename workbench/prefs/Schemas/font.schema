;
; SYS/font.prefs: three FONT chunks, one per fp_Type, in the packed
; big-endian layout of workbench/prefs/font/prefs.h (FileFontPrefs).
schema   1
file     SYS/font.prefs
layout   workbench/prefs/font/prefs.h FileFontPrefs
chunk    FONT  size 156  select fp_Type@14:2

[font/workbench]  select 0  level novice  applier iprefs live
  name      fp_Name@28:128             type font   default topaz.font
  size      fp_TextAttr_ta_YSize@24:2  type int    range 4..64  unit points  default 8
  style     fp_TextAttr_ta_Style@26:1  type flags  choices underline=1,bold=2,italic=4
  frontpen  fp_FrontPen@16:1           type pen    level expert
  backpen   fp_BackPen@17:1            type pen    level expert
  drawmode  fp_Drawmode@18:1           type enum   choices jam1=0,jam2=1,complement=2  level expert

[font/system]     select 1  level average  applier iprefs live
  name      fp_Name@28:128             type font
  size      fp_TextAttr_ta_YSize@24:2  type int    range 4..64  unit points
  style     fp_TextAttr_ta_Style@26:1  type flags  choices underline=1,bold=2,italic=4  level expert

[font/screen]     select 2  level average  applier iprefs live
  name      fp_Name@28:128             type font
  size      fp_TextAttr_ta_YSize@24:2  type int    range 4..64  unit points
  style     fp_TextAttr_ta_Style@26:1  type flags  choices underline=1,bold=2,italic=4  level expert
