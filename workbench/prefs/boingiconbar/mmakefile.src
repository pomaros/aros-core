# Makefile to make Serial prefs program.

include $(SRCDIR)/config/aros.cfg

FILES := main locale bibeditor prefs args misc

EXEDIR      := $(AROSDIR)/Prefs

#MM- workbench-prefs : workbench-prefs-iconbar
#MM workbench-prefs-iconbar : includes linklibs workbench-prefs-iconbar-catalogs

%build_prog mmake=workbench-prefs-iconbar \
    progname=BoingIconBar targetdir=$(EXEDIR) \
    files=$(FILES)

# The same editor as a shared class for the settings window.
CLASSFILES := locale prefs args misc boingiconbareditor_init bibeditor_mcc

#MM- workbench-prefs : workbench-prefs-iconbar-class
#MM workbench-prefs-iconbar-class : includes linklibs workbench-prefs-iconbar-catalogs workbench-classes-zune-prefseditor

%build_module mmake=workbench-prefs-iconbar-class \
    modname=BoingIconBarEditor modtype=mcc \
    conffile=boingiconbareditor.conf files="$(CLASSFILES)"

%common
