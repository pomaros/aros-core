include $(SRCDIR)/config/aros.cfg

FILES := main args locale fweditor prefsdata filter nat

EXEDIR := $(AROSDIR)/Prefs

#MM- workbench-prefs : workbench-prefs-firewall

#MM workbench-prefs-firewall : includes linklibs workbench-prefs-firewall-catalogs

USER_CPPFLAGS := -DHAVE_STRLCPY

%build_prog mmake=workbench-prefs-firewall \
    progname=Firewall targetdir=$(EXEDIR) \
    files=$(FILES)

# The same editor as a shared class for the settings window.
CLASSFILES := args locale prefsdata filter nat firewalleditor_init fweditor_mcc

#MM- workbench-prefs : workbench-prefs-firewall-class
#MM workbench-prefs-firewall-class : includes linklibs workbench-prefs-firewall-catalogs workbench-classes-zune-prefseditor

%build_module mmake=workbench-prefs-firewall-class \
    modname=FirewallEditor modtype=mcc \
    conffile=firewalleditor.conf files="$(CLASSFILES)"

%common
