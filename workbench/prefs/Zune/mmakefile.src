#
# Makefile for Zune prefs program

include $(SRCDIR)/config/aros.cfg

FILES  := zune listview prefswindowp zunestuff windowp buttonsp groupsp cyclesp slidersp \
scrollbarsp listviewsp stringsp specialp navigationp framesp locale \
systemp

EXEDIR := $(AROS_PREFS)

USER_CFLAGS := $(PARANOIA_CFLAGS)

#MM- workbench-prefs : workbench-prefs-zune
#MM workbench-prefs-zune : includes linklibs workbench-prefs-zune-catalogs

%build_prog mmake=workbench-prefs-zune \
    progname=Zune targetdir=$(EXEDIR) \
    files=$(FILES) uselibs="muiscreen"

# The global preferences as a Settings page, from the same panels; the
# Scrollbars panel stays in the program (see zuneeditor.c).
EDITORFILES := zuneeditor zunestuff windowp buttonsp groupsp cyclesp slidersp \
listviewsp stringsp specialp navigationp framesp locale systemp

#MM- workbench-prefs : workbench-prefs-zune-class
#MM workbench-prefs-zune-class : includes linklibs workbench-prefs-zune-catalogs workbench-classes-zune-prefseditor

%build_module mmake=workbench-prefs-zune-class \
    modname=ZuneEditor modtype=mcc conffile=zuneeditor.conf files="$(EDITORFILES)" \
    uselibs="muiscreen"

%common
