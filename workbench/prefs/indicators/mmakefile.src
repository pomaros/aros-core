include $(SRCDIR)/config/aros.cfg
#MM- workbench-prefs : workbench-prefs-indicators
#MM workbench-prefs-indicators : workbench-prefs-indicators-class workbench-classes-zune-systemprefswindow
#MM workbench-prefs-indicators-class : includes linklibs workbench-classes-zune-prefseditor
%build_prog mmake=workbench-prefs-indicators progname=Indicators targetdir=$(AROS_PREFS) files="main"
%build_module mmake=workbench-prefs-indicators-class modname=IndicatorsEditor modtype=mcc conffile=editor.conf files="editor"
%common
