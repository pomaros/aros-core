#
# Makefile to build Input Prefs program.

include $(SRCDIR)/config/aros.cfg

FILES       := main args keymap locale misc ipeditor prefs stringify
EXEDIR      := $(AROS_PREFS)

#MM- workbench-prefs : workbench-prefs-input
#MM workbench-prefs-input : workbench-prefs-input-catalogs

USER_CFLAGS := -DADATE="\"$(AROS_BUILD_DATE)\""

%build_prog mmake=workbench-prefs-input \
    progname=Input targetdir=$(EXEDIR) \
    files=$(FILES)

# The same editor as a shared class for the settings window.
CLASSFILES := args keymap locale misc prefs stringify inputeditor_init ipeditor_mcc

#MM- workbench-prefs : workbench-prefs-input-class
#MM workbench-prefs-input-class : workbench-prefs-input-catalogs workbench-classes-zune-prefseditor

%build_module mmake=workbench-prefs-input-class \
    modname=InputEditor modtype=mcc \
    conffile=inputeditor.conf files="$(CLASSFILES)"

%common
