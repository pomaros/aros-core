# Makefile to make Printer prefs program.

include $(SRCDIR)/config/aros.cfg

FILES := main locale editor prefs args misc

EXEDIR      := $(AROSDIR)/Prefs

USER_CFLAGS := -DMUI_OBSOLETE

#MM- workbench-prefs : workbench-prefs-printer
#MM workbench-prefs-printer : includes linklibs workbench-prefs-printer-catalogs

%build_prog mmake=workbench-prefs-printer \
    progname=Printer targetdir=$(EXEDIR) \
    files=$(FILES)

# The same editor as a shared class for the settings window.
CLASSFILES := locale prefs args misc printereditor_init editor_mcc

#MM- workbench-prefs : workbench-prefs-printer-class
#MM workbench-prefs-printer-class : includes linklibs workbench-prefs-printer-catalogs workbench-classes-zune-prefseditor

%build_module mmake=workbench-prefs-printer-class \
    modname=PrinterEditor modtype=mcc \
    conffile=printereditor.conf files="$(CLASSFILES)"

%common
