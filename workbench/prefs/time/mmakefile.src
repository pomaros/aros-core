include $(SRCDIR)/config/aros.cfg

USER_INCLUDES := -I$(SRCDIR)/workbench/c/TimeZone

#MM- workbench-prefs : workbench-prefs-time
#MM workbench-prefs-time : workbench-prefs-time-class workbench-classes-zune-systemprefswindow includes linklibs
#MM workbench-prefs-time-class : workbench-classes-zune-prefseditor workbench-classes-zune-calendar workbench-classes-zune-clock includes linklibs

%build_prog mmake=workbench-prefs-time \
    progname=Time targetdir=$(AROS_PREFS) files=main

%build_module mmake=workbench-prefs-time-class \
    modname=TimeEditor modtype=mcc conffile=editor.conf files="editor tzrule"

%common
