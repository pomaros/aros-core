include $(SRCDIR)/config/aros.cfg

FILES := settings_init settings_schema settings_iff settings_store settings_notify \
         getsettinga setsettinga replacesettingsa notifysettinga \
         enumsettingsa describesettinga

USER_LDFLAGS := -static

#MM- workbench-libs-complete : workbench-libs-settings
%build_module mmake=workbench-libs-settings \
    modname=settings modtype=library \
    files="$(FILES)"

#MM includes-copy
INCLUDE_FILES := $(call WILDCARD, include/libraries/*.h)
%copy_includes path=libraries dir=include/libraries
