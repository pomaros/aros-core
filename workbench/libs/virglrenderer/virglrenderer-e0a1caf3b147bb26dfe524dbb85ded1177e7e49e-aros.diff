diff --git a/src/venus/vkr_aros.c b/src/venus/vkr_aros.c
new file mode 100644
index 0000000..d7a66e2
--- /dev/null
+++ b/src/venus/vkr_aros.c
@@ -0,0 +1,48 @@
+/*
+ * Copyright (c) 2026 John Knipper
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "vkr_common.h"
+
+#include "vkr_aros.h"
+#include "vkr_metal_helpers.h"
+
+const struct vkr_aros_shm_ops *vkr_aros_shm;
+
+void
+vkr_aros_set_shm_ops(const struct vkr_aros_shm_ops *ops)
+{
+   vkr_aros_shm = ops;
+}
+
+/* Host-visible device memory is the embedder's shared memory, imported
+ * with VK_EXT_external_memory_host; the Metal path's structure carries it. */
+struct vkr_mtl_shm *
+vkr_mtl_shm_alloc(void *alignment, uint64_t size)
+{
+   struct vkr_mtl_shm *shm = calloc(1, sizeof(*shm));
+   size_t align = (size_t)(uintptr_t)alignment;
+
+   if (!shm || !vkr_aros_shm)
+      goto fail;
+   shm->shm_size = (size + align - 1) & ~(uint64_t)(align - 1);
+   shm->shm_ptr = vkr_aros_shm->create(shm->shm_size, align, &shm->shm_fd);
+   if (!shm->shm_ptr)
+      goto fail;
+   return shm;
+
+fail:
+   free(shm);
+   return NULL;
+}
+
+void
+vkr_mtl_shm_free(struct vkr_mtl_shm *shm)
+{
+   if (!shm)
+      return;
+   vkr_aros_shm->unmap(shm->shm_ptr, shm->shm_size);
+   vkr_aros_shm->close(shm->shm_fd);
+   free(shm);
+}
diff --git a/src/venus/vkr_aros.h b/src/venus/vkr_aros.h
new file mode 100644
index 0000000..46318cb
--- /dev/null
+++ b/src/venus/vkr_aros.h
@@ -0,0 +1,42 @@
+/*
+ * Copyright (c) 2026 John Knipper
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef VKR_AROS_H
+#define VKR_AROS_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+/*
+ * Shared memory between the Venus renderer and its client on AROS.
+ *
+ * AROS has no file descriptors to pass memory around. The embedder that
+ * hosts the renderer supplies the memory both sides see and names each
+ * region by a handle, which travels wherever virglrenderer passes an fd.
+ * A loopback embedder can hand out ordinary memory; one serving an
+ * isolated domain hands out pages that domain maps too.
+ */
+struct vkr_aros_shm_ops {
+   /* Memory the client can map: returns the renderer's address and the
+    * handle for the client, or NULL. */
+   void *(*create)(size_t size, size_t alignment, int *handle);
+   /* The renderer's address for a region the client created. */
+   void *(*import)(int handle, size_t size);
+   /* Another reference to a region, for a second recipient. */
+   int (*share)(int handle);
+   /* Drops a handle; the region goes when its last handle and mapping do. */
+   void (*close)(int handle);
+   /* Drops the renderer's mapping. */
+   void (*unmap)(void *ptr, size_t size);
+};
+
+extern const struct vkr_aros_shm_ops *vkr_aros_shm;
+
+void
+vkr_aros_set_shm_ops(const struct vkr_aros_shm_ops *ops);
+
+#define getpagesize() 4096
+
+#endif /* VKR_AROS_H */
