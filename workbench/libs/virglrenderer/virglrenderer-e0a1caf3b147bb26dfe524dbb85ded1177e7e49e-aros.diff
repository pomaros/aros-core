+
+/* Diagnostic for a host that sees no progress: every ring and sync queue of
+ * every context, without locks, so that it also works when one is held.
+ */
+void
+vkr_renderer_dump(void (*emit)(const char *line, void *data), void *data)
+{
+   char line[256];
+
+   list_for_each_entry (struct vkr_context, ctx, &vkr_state.contexts, head) {
+      snprintf(line, sizeof(line), "ctx=%u wait_ring id=%" PRIu64 " seqno=%u fatal=%d",
+               ctx->ctx_id, ctx->wait_ring.id, ctx->wait_ring.seqno, ctx->cs_fatal_error);
+      emit(line, data);
+      list_for_each_entry (struct vkr_ring, ring, &ctx->rings, head) {
+         const uint32_t head = atomic_load(ring->control.head);
+         const uint32_t tail = atomic_load(ring->control.tail);
+         uint32_t cmd = 0;
+         if (head != tail)
+            memcpy(&cmd, ring->buffer.data + (head & ring->buffer.mask), sizeof(cmd));
+         snprintf(line, sizeof(line),
+                  "ring=%" PRIu64 " head=%u tail=%u cur=%u status=%#x started=%d pending_notify=%d"
+                  " cmd_at_head=%u virtqueue_seqno=%" PRIu64,
+                  ring->id, head, tail, ring->buffer.cur, atomic_load(ring->control.status),
+                  ring->started, ring->pending_notify, cmd, ring->virtqueue_seqno);
+         emit(line, data);
+         if (head != tail) {
+            /* the raw words of the command at the head, up to one line */
+            size_t n = 0;
+            n += snprintf(line + n, sizeof(line) - n, "ring=%" PRIu64 " head_words=", ring->id);
+            for (uint32_t i = 0; i < 24 && n + 10 < sizeof(line) && i * 4 < tail - head; i++) {
+               uint32_t w;
+               memcpy(&w, ring->buffer.data + ((head + i * 4) & ring->buffer.mask), sizeof(w));
+               n += snprintf(line + n, sizeof(line) - n, "%x ", w);
+            }
+            emit(line, data);
+         }
+#ifdef __AROS__
+         {
+            const struct Task *task = ring->task;
+            if (task)
+               snprintf(line, sizeof(line),
+                        "ring=%" PRIu64 " task=%p state=%u wait=%#lx received=%#lx sp=%p succ=%p exit_ret=%d",
+                        ring->id, (void *)task, task->tc_State, (unsigned long)task->tc_SigWait,
+                        (unsigned long)task->tc_SigRecvd, task->tc_SPReg, (void *)task->tc_Node.ln_Succ,
+                        ring->exit_ret);
+            else
+               snprintf(line, sizeof(line), "ring=%" PRIu64 " task=none (thread never ran)", ring->id);
+            emit(line, data);
+         }
+#endif
+      }
+      for (uint32_t i = 0; i < ARRAY_SIZE(ctx->sync_queues); i++) {
+         const struct vkr_queue *queue = ctx->sync_queues[i];
+         unsigned pending = 0;
+         if (!queue)
+            continue;
+         list_for_each_entry (struct vkr_queue_sync, sync, &queue->sync_thread.syncs, head)
+            pending++;
+         snprintf(line, sizeof(line), "queue=%u ring_idx=%u pending_syncs=%u join=%d", i,
+                  queue->ring_idx, pending, queue->sync_thread.join);
+         emit(line, data);
+      }
+   }
 }
