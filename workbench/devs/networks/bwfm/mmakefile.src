include $(SRCDIR)/config/aros.cfg
#MM- workbench-devs-networks-bwfm : workbench-libs-keyring-includes

#
# The datapath and the SANA-II side live here; the chip itself is driven by
# bwfm.resource in the SoC tree, and this device calls it through proto/bwfm.h.
# That header is generated by the resource, so its includes have to exist first
# before building this device. Select the resource for the target platform;
# installing both overwrites the common proto/bwfm.h and inline/bwfm.h paths.
#
#MM- workbench-devs-networks-bwfm-apple : kernel-bwfm-apple-includes
#MM- workbench-devs-networks-bwfm-raspi : kernel-bwfm-bcm2708-includes

%build_module mmake=workbench-devs-networks-bwfm \
    modname=bwfm modtype=device \
    files="bwfm_dev" \
    moduledir=Devs/Networks

%common
