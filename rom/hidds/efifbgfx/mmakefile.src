
include $(SRCDIR)/config/aros.cfg

#MM kernel-hidd-efifbgfx : kernel-hidd-gfx-includes

FILES	:=	\
	efifbgfx_init \
	efifbgfx_hiddclass \
	efifbgfx_displayclass \
	efifbgfx_support \
	efifbgfx_bitmapclass

USER_CPPFLAGS := \
               -D__OOP_NOATTRBASES__

%build_module mmake=kernel-hidd-efifbgfx \
  modname=efifbgfx modtype=hidd \
  files=$(FILES)

# Shared framebuffer layout and included implementations must rebuild together.
FB_SHARED_INPUTS := $(wildcard $(SRCDIR)/rom/hidds/efifbgfx/*.h $(SRCDIR)/rom/hidds/efifbgfx/*.c)
$(kernel-hidd-efifbgfx_OBJS) $(kernel-hidd-efifbgfx_STARTOBJS) $(kernel-hidd-efifbgfx_ENDOBJS): $(FB_SHARED_INPUTS) $(wildcard $(SRCDIR)/$(CURDIR)/*.h)
