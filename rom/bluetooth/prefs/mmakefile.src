include $(SRCDIR)/config/aros.cfg

FILES := bluetoothprefs
CLASSFILES := editor actions ActionClass IconListClass ScanWinClass DevWinClass bluzinglogo icons

#MM- kernel-bluetooth-prefs : kernel-bluetooth-library-includes linklibs kernel-bluetooth-prefs-class kernel-bluetooth-prefs-worker workbench-classes-zune-systemprefswindow
#MM- workbench-prefs : kernel-bluetooth-prefs
#MM kernel-bluetooth-prefs-worker : kernel-bluetooth-library-includes linklibs
#MM kernel-bluetooth-prefs-class : kernel-bluetooth-prefs-worker kernel-bluetooth-library-includes linklibs workbench-classes-zune-prefseditor

USER_CPPFLAGS := -DMUIMASTER_YES_INLINE_STDARG
USER_LDFLAGS := -static

#MM- kernel-bluetooth-prefs : kernel-bluetooth-prefs-icon

%build_prog progname="Bluetooth" mmake=kernel-bluetooth-prefs \
    files=$(FILES) targetdir=$(AROS_PREFS)

# Keep the original Trident-based fallback for other icon sets.
# Gorilla and GorillaSmall supply Bluetooth.info through their iconsets.
ifeq ($(filter Gorilla GorillaSmall,$(AROS_TARGET_ICONSET)),)
%copy_files_q mmake=kernel-bluetooth-prefs-icon \
    src="$(SRCDIR)/$(CURDIR)" files="Bluetooth.info" dst="$(AROS_PREFS)"
else
.PHONY: kernel-bluetooth-prefs-icon
#MM
kernel-bluetooth-prefs-icon:
	@$(NOP)
endif

%build_module mmake=kernel-bluetooth-prefs-class \
    modname=BluetoothEditor modtype=mcc conffile=editor.conf files=$(CLASSFILES)

%build_prog mmake=kernel-bluetooth-prefs-worker \
    progname=BluetoothAction targetdir=$(AROSDIR)/System files=actionworker

%common
