
include $(SRCDIR)/config/aros.cfg

FILES := adminspaces \
	 bitmap \
	 btreenodes \
	 cachebuffers \
	 debug \
	 nodes \
	 support \
	 transactions \
	 asmsupport \
	 objects \
	 locks \
	 deviceio \
	 cachedio \
	 filesystemmain \
	 globals \
	 req \
	 sfs_security

USER_CPPFLAGS := -DSFS_BE -DADATE="\"$(AROS_BUILD_DATE)\""
USER_LDFLAGS := -static

#MM kernel-fs-sfs : kernel-fs-sfs-deps
#MM- kernel-fs-sfs-deps : includes kernel-$(TARGET_USELOGRES)-log-includes kernel-security-includes kernel-task-includes

%build_module mmake=kernel-fs-sfs \
    modname=sfs modtype=handler \
    files="$(FILES)" uselibs=debug

%common
