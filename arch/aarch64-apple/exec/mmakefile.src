include $(SRCDIR)/config/aros.cfg

%set_archincludes mainmmake=kernel-exec maindir=rom/exec \
  modname=exec pri=10 arch=apple-aarch64 \
  includes="-I$(SRCDIR)/$(CURDIR)"
%get_archincludes modname=kernel includeflag=TARGET_KERNEL_INCLUDES maindir=rom/kernel
%get_archincludes modname=exec includeflag=TARGET_EXEC_INCLUDES maindir=rom/exec
USER_INCLUDES := $(TARGET_EXEC_INCLUDES) -I$(SRCDIR)/rom/exec $(TARGET_KERNEL_INCLUDES) -I$(SRCDIR)/rom/kernel -I$(GENINCDIR)

%build_archspecific \
  mainmmake=kernel-exec maindir=rom/exec modname=exec \
  files="supervisor" asmfiles="superstate_helper" arch=apple-aarch64

%common
