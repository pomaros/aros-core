# The Apple bootstrap enters kernel.resource before an FP/SIMD ownership and
# task-context policy exists.  Keep compiler-generated vector accesses out of
# both the generic kernel sources and the Apple early-startup additions.
USER_CFLAGS += $(CFLAGS_GENERAL_REGS_ONLY)
