include $(SRCDIR)/config/aros.cfg

# entropy_hw.c needs entropy.resource's private headers and the Apple
# kernel attribute that carries the boot loader's seed.
USER_INCLUDES := -I$(SRCDIR)/rom/entropy -I$(SRCDIR)/arch/aarch64-apple/include

%build_archspecific \
  mainmmake=kernel-entropy modname=entropy maindir=rom/entropy \
  arch=apple-aarch64 \
  files="entropy_hw"

%common
