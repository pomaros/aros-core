include $(SRCDIR)/config/aros.cfg

USER_INCLUDES := -I$(SRCDIR)/$(CURDIR) -I$(SRCDIR)/rom/timer

%build_archspecific \
  mainmmake=kernel-timer maindir=rom/timer \
  arch=apple-aarch64 modname=timer \
  files="abortio beginio timer_init ticks getsystime getuptime readeclock pauseuptime"

%common
