	$(Q)$(TARGET_CC) --target=aarch64-none-elf -ffreestanding -fpie \
	    -mgeneral-regs-only -I$(APPLE_NATIVE_SOURCE_DIR) -DAROS_APPLE_STAGE2_FRAME_EYES=1 -c $< -o $@

$(APPLE_STAGE2_GRAPHICS_EYES_ENTRY_OBJ): \
