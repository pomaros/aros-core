    $(APPLE_STAGE2_PREPARE_OBJS) $(APPLE_STAGE2_SOURCE_DIR)/stage2.ld
	$(Q)$(KERNEL_LD) -T $(APPLE_STAGE2_SOURCE_DIR)/stage2.ld \
	    --gc-sections -o $@ $(APPLE_STAGE2_A4_ENTRY_OBJ) \
	    $(APPLE_STAGE2_A4_GUARD_OBJ) $(APPLE_STAGE2_A4_CACHE_MAIN_OBJ) \
	    $(APPLE_STAGE2_A4_CACHE_OPS_OBJ) $(APPLE_STAGE2_A4_CACHE_CALL_OBJ) \
	    $(APPLE_STAGE2_BUILD_DIR)/stage2_sha256.o \
	    $(APPLE_STAGE2_PREPARE_OBJS)

$(APPLE_STAGE2_A4_CACHE_TEST_ELF): \
    $(APPLE_STAGE2_A4_CACHE_TEST_ENTRY_OBJ) \
    $(APPLE_STAGE2_COMMON_OBJS) $(APPLE_STAGE2_A4_CACHE_QEMU_OPS_OBJ) \
    $(APPLE_STAGE2_A4_CACHE_CALL_OBJ) $(APPLE_STAGE2_A4_CACHE_QEMU_OBJ) \
    $(APPLE_STAGE2_SOURCE_DIR)/stage2.ld
	$(Q)$(KERNEL_LD) -T $(APPLE_STAGE2_SOURCE_DIR)/stage2.ld \
	    --gc-sections -o $@ $(APPLE_STAGE2_A4_CACHE_TEST_ENTRY_OBJ) \
	    $(APPLE_STAGE2_COMMON_OBJS) $(APPLE_STAGE2_A4_CACHE_QEMU_OPS_OBJ) \
	    $(APPLE_STAGE2_A4_CACHE_CALL_OBJ) $(APPLE_STAGE2_A4_CACHE_QEMU_OBJ)

$(APPLE_STAGE2_A5_ELF): $(APPLE_STAGE2_ENTRY_OBJ) \
    $(APPLE_STAGE2_PREPARE_OBJS) $(APPLE_STAGE2_BUILD_DIR)/stage2_probe.o \
    $(APPLE_STAGE2_A5_MAIN_OBJ) $(APPLE_STAGE2_BUILD_DIR)/stage2_native_a5.o $(APPLE_STAGE2_A5_OBSERVER_OBJ) \
    $(APPLE_STAGE2_A5_TOPOLOGY_OBJ) $(APPLE_STAGE2_SOURCE_DIR)/stage2.ld
	$(Q)$(KERNEL_LD) -T $(APPLE_STAGE2_SOURCE_DIR)/stage2.ld \
	    --gc-sections -o $@ $(APPLE_STAGE2_ENTRY_OBJ) \
	    $(APPLE_STAGE2_PREPARE_OBJS) \
	    $(APPLE_STAGE2_BUILD_DIR)/stage2_probe.o \
	    $(APPLE_STAGE2_A5_MAIN_OBJ) $(APPLE_STAGE2_BUILD_DIR)/stage2_native_a5.o $(APPLE_STAGE2_A5_OBSERVER_OBJ) \
	    $(APPLE_STAGE2_A5_TOPOLOGY_OBJ)

$(APPLE_STAGE2_A5_EYES_ELF): $(APPLE_STAGE2_A5_EYES_ENTRY_OBJ) \
    $(APPLE_STAGE2_PREPARE_OBJS) $(APPLE_STAGE2_BUILD_DIR)/stage2_probe.o \
    $(APPLE_STAGE2_A5_EYES_MAIN_OBJ) $(APPLE_STAGE2_BUILD_DIR)/stage2_native_a5_eyes.o \
    $(APPLE_STAGE2_A5_COMPACT_OBSERVER_OBJ) \
    $(APPLE_STAGE2_A5_TOPOLOGY_OBJ) $(APPLE_STAGE2_A5_EYES_MARK_OBJ) \
    $(APPLE_STAGE2_SOURCE_DIR)/stage2.ld
	$(Q)$(KERNEL_LD) -T $(APPLE_STAGE2_SOURCE_DIR)/stage2.ld \
	    --gc-sections -o $@ $(APPLE_STAGE2_A5_EYES_ENTRY_OBJ) \
	    $(APPLE_STAGE2_PREPARE_OBJS) \
	    $(APPLE_STAGE2_BUILD_DIR)/stage2_probe.o \
	    $(APPLE_STAGE2_A5_EYES_MAIN_OBJ) $(APPLE_STAGE2_BUILD_DIR)/stage2_native_a5_eyes.o \
	    $(APPLE_STAGE2_A5_COMPACT_OBSERVER_OBJ) \
	    $(APPLE_STAGE2_A5_TOPOLOGY_OBJ) $(APPLE_STAGE2_A5_EYES_MARK_OBJ)

$(APPLE_STAGE2_GRAPHICS_EYES_ELF): \
    $(APPLE_STAGE2_GRAPHICS_EYES_ENTRY_OBJ) \
    $(APPLE_STAGE2_PREPARE_OBJS) $(APPLE_STAGE2_BUILD_DIR)/stage2_probe.o \
    $(APPLE_STAGE2_GRAPHICS_EYES_MAIN_OBJ) $(APPLE_STAGE2_BUILD_DIR)/stage2_native_graphics_eyes.o \
    $(APPLE_STAGE2_A5_EYES_MARK_OBJ) $(APPLE_STAGE2_SPI_EYES_OBJS) \
    $(APPLE_STAGE2_SOURCE_DIR)/stage2.ld
	$(Q)$(KERNEL_LD) -T $(APPLE_STAGE2_SOURCE_DIR)/stage2.ld \
	    --gc-sections -o $@ $(APPLE_STAGE2_GRAPHICS_EYES_ENTRY_OBJ) \
	    $(APPLE_STAGE2_PREPARE_OBJS) \
	    $(APPLE_STAGE2_BUILD_DIR)/stage2_probe.o \
	    $(APPLE_STAGE2_GRAPHICS_EYES_MAIN_OBJ) $(APPLE_STAGE2_BUILD_DIR)/stage2_native_graphics_eyes.o \
	    $(APPLE_STAGE2_A5_EYES_MARK_OBJ) $(APPLE_STAGE2_SPI_EYES_OBJS)

$(APPLE_STAGE2_GRAPHICS_EYES_BIN): $(APPLE_STAGE2_GRAPHICS_EYES_ELF)
	$(Q)$(OBJCOPY) -O binary $< $@

$(APPLE_STAGE2_BIN): $(APPLE_STAGE2_ELF)
	$(Q)$(OBJCOPY) -O binary $< $@

$(APPLE_STAGE2_TEST_BIN): $(APPLE_STAGE2_TEST_ELF)
	$(Q)$(OBJCOPY) -O binary $< $@

$(APPLE_STAGE2_EXCEPTION_TEST_BIN): $(APPLE_STAGE2_EXCEPTION_TEST_ELF)
	$(Q)$(OBJCOPY) -O binary $< $@

$(APPLE_STAGE2_A4_BIN): $(APPLE_STAGE2_A4_ELF)
	$(Q)$(OBJCOPY) -O binary $< $@

$(APPLE_STAGE2_A4_CACHE_BIN): $(APPLE_STAGE2_A4_CACHE_ELF)
	$(Q)$(OBJCOPY) -O binary $< $@

$(APPLE_STAGE2_A4_CACHE_TEST_BIN): $(APPLE_STAGE2_A4_CACHE_TEST_ELF)
	$(Q)$(OBJCOPY) -O binary $< $@

$(APPLE_STAGE2_A5_BIN): $(APPLE_STAGE2_A5_ELF)
	$(Q)$(OBJCOPY) -O binary $< $@

$(APPLE_STAGE2_A5_EYES_BIN): $(APPLE_STAGE2_A5_EYES_ELF)
	$(Q)$(OBJCOPY) -O binary $< $@

%rule_makedirs dirs="$(APPLE_TARGET_PROBE_DIR)" \
    setuptarget="$(APPLE_TARGET_PROBE_OBJS) $(APPLE_TARGET_PROBE_DEPS)"

%rule_makedirs dirs="$(APPLE_STAGE2_BUILD_DIR) $(APPLE_STAGE2_INSTALL_DIR)" \
    setuptarget="$(APPLE_STAGE2_COMMON_OBJS) $(APPLE_STAGE2_ENTRY_OBJ) \
    $(APPLE_STAGE2_TEST_ENTRY_OBJ) $(APPLE_STAGE2_EXCEPTION_TEST_ENTRY_OBJ) \
    $(APPLE_STAGE2_A4_ENTRY_OBJ) $(APPLE_STAGE2_A4_CACHE_TEST_ENTRY_OBJ) \
    $(APPLE_STAGE2_A4_GUARD_OBJ) \
    $(APPLE_STAGE2_A4_MAIN_OBJ) $(APPLE_STAGE2_A4_CACHE_MAIN_OBJ) \
    $(APPLE_STAGE2_A4_CACHE_OPS_OBJ) $(APPLE_STAGE2_A4_CACHE_QEMU_OPS_OBJ) \
    $(APPLE_STAGE2_A4_CACHE_CALL_OBJ) \
    $(APPLE_STAGE2_A4_CACHE_QEMU_OBJ) \
    $(APPLE_STAGE2_A5_MAIN_OBJ) $(APPLE_STAGE2_BUILD_DIR)/stage2_native_a5.o $(APPLE_STAGE2_A5_OBSERVER_OBJ) \
    $(APPLE_STAGE2_A5_COMPACT_OBSERVER_OBJ) \
    $(APPLE_STAGE2_A5_TOPOLOGY_OBJ) $(APPLE_STAGE2_A5_EYES_MAIN_OBJ) $(APPLE_STAGE2_BUILD_DIR)/stage2_native_a5_eyes.o \
    $(APPLE_STAGE2_A5_EYES_ENTRY_OBJ) $(APPLE_STAGE2_A5_EYES_MARK_OBJ) \
    $(APPLE_STAGE2_GRAPHICS_EYES_ENTRY_OBJ) \
    $(APPLE_STAGE2_GRAPHICS_EYES_MAIN_OBJ) $(APPLE_STAGE2_BUILD_DIR)/stage2_native_graphics_eyes.o \
    $(APPLE_STAGE2_BUILD_DIR)/stage2_sha256.o \
    $(APPLE_STAGE2_ELF) $(APPLE_STAGE2_TEST_ELF) \
    $(APPLE_STAGE2_EXCEPTION_TEST_ELF) $(APPLE_STAGE2_A4_ELF) \
    $(APPLE_STAGE2_A4_CACHE_ELF) $(APPLE_STAGE2_A4_CACHE_TEST_ELF) \
    $(APPLE_STAGE2_A5_ELF) $(APPLE_STAGE2_A5_EYES_ELF) \
    $(APPLE_STAGE2_GRAPHICS_EYES_ELF) $(APPLE_STAGE2_GRAPHICS_EYES_BIN) \
    $(APPLE_STAGE2_BIN) $(APPLE_STAGE2_TEST_BIN) \
    $(APPLE_STAGE2_EXCEPTION_TEST_BIN) $(APPLE_STAGE2_A4_BIN) \
    $(APPLE_STAGE2_A4_CACHE_BIN) $(APPLE_STAGE2_A4_CACHE_TEST_BIN) \
    $(APPLE_STAGE2_A5_BIN) $(APPLE_STAGE2_A5_EYES_BIN)"

%rule_compile_multi mmake=apple-target-probe \
    basenames="$(APPLE_TARGET_PROBE_FILES)" \
    targetdir=$(APPLE_TARGET_PROBE_DIR) compiler=kernel

%include_deps depstargets=apple-target-probe deps=$(APPLE_TARGET_PROBE_DEPS)

%common

$(APPLE_STAGE2_BUILD_DIR)/early_fdt.o: $(AROS_EARLY_FDT_DIR)/early_fdt.c $(AROS_EARLY_FDT_DIR)/early_fdt.h $(AROS_EARLY_FDT_DIR)/freestanding.h | $(APPLE_STAGE2_BUILD_DIR)
	$(Q)$(TARGET_CC) $(APPLE_STAGE2_CFLAGS) -c $< -o $@
$(APPLE_STAGE2_BUILD_DIR)/libfdt_%.o: $(AROS_EARLY_FDT_DIR)/libfdt/%.c $(AROS_EARLY_FDT_DIR)/libfdt/libfdt.h $(AROS_EARLY_FDT_DIR)/libfdt/libfdt_env.h $(AROS_EARLY_FDT_DIR)/freestanding.h | $(APPLE_STAGE2_BUILD_DIR)
	$(Q)$(TARGET_CC) $(APPLE_STAGE2_CFLAGS) -c $< -o $@

$(APPLE_STAGE2_BUILD_DIR)/pci_ecam.o: $(AROS_EARLY_FDT_DIR)/pci_ecam.c $(AROS_EARLY_FDT_DIR)/pci_ecam.h $(AROS_EARLY_FDT_DIR)/early_fdt.h | $(APPLE_STAGE2_BUILD_DIR)
	$(Q)$(TARGET_CC) $(APPLE_STAGE2_CFLAGS) -c $< -o $@

$(APPLE_STAGE2_BUILD_DIR)/stage2_native.o: $(APPLE_NATIVE_SOURCE_DIR)/stage2_native.c \
    $(APPLE_STAGE2_SOURCE_DIR)/stage2_platform.h \
    $(APPLE_NATIVE_SOURCE_DIR)/stage2_a5.h \
    $(APPLE_NATIVE_SOURCE_DIR)/stage2_frame_eyes.h
	$(Q)$(TARGET_CC) $(APPLE_STAGE2_CFLAGS)  -c $< -o $@

$(APPLE_STAGE2_BUILD_DIR)/stage2_native_a5.o: $(APPLE_NATIVE_SOURCE_DIR)/stage2_native.c \
    $(APPLE_STAGE2_SOURCE_DIR)/stage2_platform.h \
    $(APPLE_NATIVE_SOURCE_DIR)/stage2_a5.h \
    $(APPLE_NATIVE_SOURCE_DIR)/stage2_frame_eyes.h
	$(Q)$(TARGET_CC) $(APPLE_STAGE2_CFLAGS) -DAROS_APPLE_STAGE2_A5_OBSERVER=1 -c $< -o $@

$(APPLE_STAGE2_BUILD_DIR)/stage2_native_a5_eyes.o: $(APPLE_NATIVE_SOURCE_DIR)/stage2_native.c \
    $(APPLE_STAGE2_SOURCE_DIR)/stage2_platform.h \
    $(APPLE_NATIVE_SOURCE_DIR)/stage2_a5.h \
    $(APPLE_NATIVE_SOURCE_DIR)/stage2_frame_eyes.h
	$(Q)$(TARGET_CC) $(APPLE_STAGE2_CFLAGS) -DAROS_APPLE_STAGE2_A5_OBSERVER=1 -DAROS_APPLE_STAGE2_FRAME_EYES=1 -c $< -o $@

$(APPLE_STAGE2_BUILD_DIR)/stage2_native_graphics_eyes.o: $(APPLE_NATIVE_SOURCE_DIR)/stage2_native.c \
    $(APPLE_STAGE2_SOURCE_DIR)/stage2_platform.h \
    $(APPLE_NATIVE_SOURCE_DIR)/stage2_a5.h \
    $(APPLE_NATIVE_SOURCE_DIR)/stage2_frame_eyes.h
	$(Q)$(TARGET_CC) $(APPLE_STAGE2_CFLAGS) -DAROS_APPLE_STAGE2_FRAME_EYES=1 -c $< -o $@

$(APPLE_STAGE2_BUILD_DIR)/stage2_native_fdt.o: \
    $(APPLE_NATIVE_SOURCE_DIR)/stage2_native_fdt.c \
    $(APPLE_NATIVE_SOURCE_DIR)/stage2_native_fdt.h \
    $(APPLE_STAGE2_SOURCE_DIR)/stage2_fdt_internal.h
	$(Q)$(TARGET_CC) $(APPLE_STAGE2_CFLAGS) -c $< -o $@

$(APPLE_STAGE2_BUILD_DIR)/stage2_native_console.o: \
    $(APPLE_NATIVE_SOURCE_DIR)/stage2_native_console.S
	$(Q)$(TARGET_CC) --target=aarch64-none-elf -ffreestanding -fpie -mgeneral-regs-only -c $< -o $@
